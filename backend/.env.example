# Salin menjadi .env lalu isi. File .env TIDAK boleh di-commit.
# SQLite untuk pengembangan. Di produksi isi URL PostgreSQL, mis.
# postgresql+psycopg://user:pass@host:5432/peluangku
DATABASE_URL=sqlite:///./peluangku.db

# Kunci per kelas, dipisah koma, format kode_kelas:kunci
CLASS_KEYS=8A:ganti-kunci-8a,8B:ganti-kunci-8b

# Token untuk area guru (string acak panjang)
TEACHER_TOKEN=ganti-dengan-token-acak-panjang

# Alamat frontend yang boleh memanggil API (CORS), dipisah koma
FRONTEND_ORIGIN=http://localhost:5173
